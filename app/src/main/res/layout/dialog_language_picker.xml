<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/bg_surface"
    android:paddingTop="16dp"
    android:paddingBottom="24dp">

    <!-- Title -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/select_language"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        android:fontFamily="@font/jetbrains_mono"
        android:letterSpacing="0.1"
        android:paddingHorizontal="20dp"
        android:paddingBottom="12dp" />

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/shortcut_border" />

    <!-- Zulu option -->
    <TextView
        android:id="@+id/optionZulu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/lang_zulu"
        android:textColor="@color/text_primary"
        android:textSize="16sp"
        android:fontFamily="@font/jetbrains_mono"
        android:paddingHorizontal="20dp"
        android:paddingVertical="16dp"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackground" />

    <!-- Sesotho option -->
    <TextView
        android:id="@+id/optionSesotho"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/lang_sesotho"
        android:textColor="@color/text_primary"
        android:textSize="16sp"
        android:fontFamily="@font/jetbrains_mono"
        android:paddingHorizontal="20dp"
        android:paddingVertical="16dp"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackground" />

    <!-- English option -->
    <TextView
        android:id="@+id/optionEnglish"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/lang_english"
        android:textColor="@color/text_primary"
        android:textSize="16sp"
        android:fontFamily="@font/jetbrains_mono"
        android:paddingHorizontal="20dp"
        android:paddingVertical="16dp"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackground" />

</LinearLayout>
