<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    tools:context=".MainActivity">

    <!-- Top Bar -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="12dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:background="@color/bg_surface"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/headerText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/app_name"
            android:textSize="16sp"
            android:textColor="@color/claude_orange"
            android:textStyle="bold"
            android:fontFamily="@font/jetbrains_mono" />

        <!-- Connection badge -->
        <TextView
            android:id="@+id/connectionBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_connection_badge"
            android:textSize="10sp"
            android:textStyle="bold"
            android:fontFamily="@font/jetbrains_mono"
            android:letterSpacing="0.1"
            android:visibility="gone"
            android:layout_marginEnd="10dp"
            tools:text="RELAY"
            tools:visibility="visible" />

        <Button
            android:id="@+id/newSessionButton"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="@string/new_session"
            android:textSize="11sp"
            android:textColor="@color/claude_orange"
            android:fontFamily="@font/jetbrains_mono"
            android:visibility="gone"
            app:strokeColor="@color/claude_orange_dim"
            app:cornerRadius="16dp" />

    </LinearLayout>

    <!-- Connect Button -->
    <Button
        android:id="@+id/connectButton"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:text="@string/connect_to_claude"
        android:textColor="@color/text_on_orange"
        android:textSize="14sp"
        android:textStyle="bold"
        android:fontFamily="@font/jetbrains_mono"
        android:backgroundTint="@color/claude_orange"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="10dp"
        app:cornerRadius="10dp"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Terminal Output -->
    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="4dp"
        android:background="@drawable/bg_terminal"
        android:padding="14dp"
        android:scrollbarThumbVertical="@color/shortcut_border"
        android:fadeScrollbars="false"
        app:layout_constraintTop_toBottomOf="@id/connectButton"
        app:layout_constraintBottom_toTopOf="@id/shortcutScroll"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/terminalOutput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/terminal_welcome"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:fontFamily="@font/jetbrains_mono"
            android:lineSpacingMultiplier="1.35"
            android:letterSpacing="0.01" />
    </ScrollView>

    <!-- Shortcut Bar -->
    <HorizontalScrollView
        android:id="@+id/shortcutScroll"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:background="@color/bg_dark"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/inputContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/shortcutContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical" />
    </HorizontalScrollView>

    <!-- Input Area -->
    <LinearLayout
        android:id="@+id/inputContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:background="@drawable/bg_input_container"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Camera button -->
        <ImageButton
            android:id="@+id/screenshotFab"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_camera"
            android:scaleType="centerInside"
            android:contentDescription="@string/capture_screenshot"
            android:padding="8dp"
            app:tint="@color/claude_orange" />

        <!-- Message Input -->
        <EditText
            android:id="@+id/commandInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:minHeight="40dp"
            android:hint="@string/command_hint"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_dim"
            android:textSize="13sp"
            android:background="@drawable/bg_input_field"
            android:fontFamily="@font/jetbrains_mono"
            android:inputType="textMultiLine"
            android:maxLines="4"
            android:imeOptions="actionSend" />

        <!-- Send Button -->
        <Button
            android:id="@+id/sendButton"
            android:layout_width="56dp"
            android:layout_height="40dp"
            android:text="@string/send"
            android:enabled="false"
            android:backgroundTint="@color/claude_orange"
            android:textColor="@color/text_on_orange"
            android:textSize="12sp"
            android:textStyle="bold"
            android:fontFamily="@font/jetbrains_mono"
            app:cornerRadius="8dp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
