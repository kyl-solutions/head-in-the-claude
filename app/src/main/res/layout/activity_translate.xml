<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    tools:context=".TranslateActivity">

    <!-- Top Bar -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="12dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:background="@color/bg_surface"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Back button -->
        <ImageView
            android:id="@+id/backButton"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_back"
            android:scaleType="fitCenter"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:layout_marginEnd="12dp"
            app:tint="@color/text_secondary" />

        <!-- Title -->
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/translate_title"
            android:textColor="@color/claude_orange"
            android:textSize="16sp"
            android:textStyle="bold"
            android:fontFamily="@font/jetbrains_mono" />

        <!-- Status indicator -->
        <TextView
            android:id="@+id/statusIndicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="9sp"
            android:textColor="@color/text_dim"
            android:fontFamily="@font/jetbrains_mono"
            tools:text="Ready" />
    </LinearLayout>

    <!-- Language Selector Row -->
    <LinearLayout
        android:id="@+id/languageRow"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Source Language -->
        <TextView
            android:id="@+id/sourceLangLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/lang_english"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            android:fontFamily="@font/jetbrains_mono"
            android:gravity="center" />

        <!-- Swap button -->
        <ImageView
            android:id="@+id/swapButton"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_swap"
            android:scaleType="fitCenter"
            android:padding="6dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Swap languages"
            app:tint="@color/claude_orange" />

        <!-- Target Language -->
        <TextView
            android:id="@+id/targetLangLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/lang_zulu"
            android:textColor="@color/claude_orange"
            android:textSize="14sp"
            android:textStyle="bold"
            android:fontFamily="@font/jetbrains_mono"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:background="?attr/selectableItemBackgroundBorderless" />
    </LinearLayout>

    <!-- Source Text Card -->
    <androidx.cardview.widget.CardView
        android:id="@+id/sourceCard"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="8dp"
        app:cardBackgroundColor="@color/bg_surface"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:layout_constraintTop_toBottomOf="@id/languageRow"
        app:layout_constraintBottom_toTopOf="@id/translateButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="0.35">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- Source text input -->
            <EditText
                android:id="@+id/sourceText"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:padding="14dp"
                android:hint="@string/translate_hint_source"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_dim"
                android:textSize="14sp"
                android:fontFamily="@font/jetbrains_mono"
                android:background="@android:color/transparent"
                android:inputType="textMultiLine"
                android:gravity="top|start"
                android:lineSpacingMultiplier="1.3"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toTopOf="@id/sourceActions"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Source action buttons -->
            <LinearLayout
                android:id="@+id/sourceActions"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="end|center_vertical"
                android:paddingHorizontal="8dp"
                android:paddingVertical="6dp"
                android:background="@color/shortcut_bg"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <!-- Paste button -->
                <TextView
                    android:id="@+id/pasteButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/action_paste"
                    android:textColor="@color/claude_orange"
                    android:textSize="11sp"
                    android:fontFamily="@font/jetbrains_mono"
                    android:padding="8dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:drawableStart="@drawable/ic_paste"
                    android:drawablePadding="4dp"
                    android:drawableTint="@color/claude_orange" />

                <!-- Clear button -->
                <TextView
                    android:id="@+id/clearButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/action_clear"
                    android:textColor="@color/text_dim"
                    android:textSize="11sp"
                    android:fontFamily="@font/jetbrains_mono"
                    android:padding="8dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackgroundBorderless" />
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>

    <!-- Translate Button -->
    <Button
        android:id="@+id/translateButton"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginHorizontal="12dp"
        android:layout_marginVertical="12dp"
        android:text="@string/action_translate"
        android:textColor="@color/text_on_orange"
        android:textSize="14sp"
        android:textStyle="bold"
        android:fontFamily="@font/jetbrains_mono"
        android:backgroundTint="@color/claude_orange"
        app:cornerRadius="10dp"
        app:layout_constraintTop_toBottomOf="@id/sourceCard"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Output Card -->
    <androidx.cardview.widget.CardView
        android:id="@+id/outputCard"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="12dp"
        app:cardBackgroundColor="@color/bg_surface"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:layout_constraintTop_toBottomOf="@id/translateButton"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- Output text (streaming) -->
            <ScrollView
                android:id="@+id/outputScroll"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:padding="14dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toTopOf="@id/outputActions"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <TextView
                    android:id="@+id/outputText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/translate_hint_output"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_dim"
                    android:textSize="14sp"
                    android:fontFamily="@font/jetbrains_mono"
                    android:lineSpacingMultiplier="1.3"
                    android:textIsSelectable="true" />
            </ScrollView>

            <!-- Output action buttons -->
            <LinearLayout
                android:id="@+id/outputActions"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="end|center_vertical"
                android:paddingHorizontal="8dp"
                android:paddingVertical="6dp"
                android:background="@color/shortcut_bg"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <!-- Copy button -->
                <TextView
                    android:id="@+id/copyButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/action_copy"
                    android:textColor="@color/claude_orange"
                    android:textSize="11sp"
                    android:fontFamily="@font/jetbrains_mono"
                    android:padding="8dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:drawableStart="@drawable/ic_copy"
                    android:drawablePadding="4dp"
                    android:drawableTint="@color/claude_orange" />
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>
