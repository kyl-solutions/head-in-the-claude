<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/shortcut_bg_pressed" />
            <stroke
                android:width="1dp"
                android:color="@color/claude_orange_dim" />
            <corners android:radius="8dp" />
            <padding
                android:left="14dp"
                android:top="6dp"
                android:right="14dp"
                android:bottom="6dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/shortcut_bg" />
            <stroke
                android:width="1dp"
                android:color="@color/shortcut_border" />
            <corners android:radius="8dp" />
            <padding
                android:left="14dp"
                android:top="6dp"
                android:right="14dp"
                android:bottom="6dp" />
        </shape>
    </item>
</selector>
