<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Kylidescope" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/signal_green</item>
        <item name="colorPrimaryVariant">@color/signal_green_dim</item>
        <item name="colorOnPrimary">@color/text_on_coral</item>
        <item name="colorSecondary">@color/signal_green_light</item>
        <item name="colorSecondaryVariant">@color/signal_green_dim</item>
        <item name="colorOnSecondary">@color/text_on_coral</item>
        <item name="android:statusBarColor">@color/bg_header</item>
        <item name="android:navigationBarColor">@color/bg_surface</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:fontFamily">@font/jetbrains_mono</item>
        <item name="tabStyle">@style/KylidescopeTabStyle</item>
    </style>

    <style name="KylidescopeTabStyle" parent="Widget.MaterialComponents.TabLayout">
        <item name="tabIndicatorColor">@color/tab_indicator</item>
        <item name="tabSelectedTextColor">@color/tab_active</item>
        <item name="tabTextColor">@color/tab_inactive</item>
        <item name="tabIndicatorHeight">3dp</item>
        <item name="tabGravity">fill</item>
        <item name="tabMode">fixed</item>
    </style>
</resources>
